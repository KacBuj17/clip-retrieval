# Folder to save output results
CLIP_RETRIEVAL_VERSION=0.1.0

# Backend service host
BACKEND_HOST=clip-back

# Backend service port
BACKEND_PORT=7777

# Backend service host port
HOST_PORT=7777

# Which CLIP index to use
INDICE_NAME=example_index

# Path to the Excel file with requests
INPUT_EXCEL=requests.xlsx

# Path to the CSV file where results will be saved
OUTPUT_CSV=results.csv

# Number of images to fetch per request
NUM_IMAGES=5

# Text input
TEXT=example text

# Folder with images
IMAGES_FOLDER=images_folder

# Folder to save output results
OUTPUT_FOLDER=output_folder

# Folder to save all resources
RESOURCES_FOLDER=resources_folder
